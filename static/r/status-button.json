			"content": "import Root, { type ButtonStatus, type StatusButtonProps } from './status-button.svelte';\n\nexport {\n\tRoot,\n\ttype StatusButtonProps as Props,\n\t//\n\tRoot as StatusButton,\n\ttype ButtonStatus,\n\ttype StatusButtonProps\n};\n",
